# Society Management System - Environment Configuration
# Copy this file to .env and update credentials for your hosting environment (Hostinger, cPanel, etc.)

# Database Credentials
DB_HOST=localhost
DB_NAME=society_management_db
DB_USER=root
DB_PASS=

# ======================================================
# SMS & WHATSAPP OTP GATEWAY CONFIGURATION
# ======================================================

# Option 1: Twilio (Supports SMS + WhatsApp worldwide)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # e.g. +12025550123
TWILIO_WHATSAPP_NUMBER=     # e.g. +14155238886

# Option 2: Fast2SMS (Indian SMS Gateway)
FAST2SMS_API_KEY=

# Option 3: MSG91 (Indian SMS Gateway)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MERIDN
MSG91_DLT_TE_ID=

# Option 4: Meta WhatsApp Cloud API
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
